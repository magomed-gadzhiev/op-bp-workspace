# Prod capture overlay configuration. Copy to .env (DO NOT COMMIT) and fill.

# Hoverfly self-signed CA (must already be in PDM trust store).
# Generate with `tools/pdm-cli/sandbox/ca/generate-ca.sh` and copy ca.crt, ca.key to ./hoverfly-certs/

# SSH bastion
PDM_BASTION_TARGET_HOST=
PDM_BASTION_TARGET_USER=
PDM_BASTION_TARGET_PORT=22
PDM_BASTION_PORT=2222
PDM_BASTION_REDACT_REGEX=["--password[= ]+\\S+","\\b[a-fA-F0-9]{32,}\\b"]
