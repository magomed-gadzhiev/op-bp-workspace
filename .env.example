# Воркспейс БП: скопируй в .env и заполни (cp .env.example .env).
# .env в git не попадает — здесь персональные токены.

# --- PDM ---
# Базовый URL PDM API (CLI сам добавит /api/...).
PDM_API_BASE=http://srv-dkr-01/pdm
# Персональный токен доступа (профиль PDM -> «Токены доступа», скоуп draft),
# формат pdw_...; показывается один раз при создании.
PDM_API_TOKEN=pdw_

# --- LLM (дублирует настройки Cline -> «OpenAI Compatible») ---
# Base URL для Cline: ОБЯЗАТЕЛЬНО с суффиксом /v1 (Cline добавит /chat/completions и /models).
LLM_BASE_URL=http://<хост>/llm/v1
# Ключ модели — от владельца (LLM_PROXY_API_KEYS nginx); это НЕ PDM-токен.
LLM_API_KEY=
# Точное имя модели — из: curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
LLM_MODEL=
